{
    "name": "atannex/tenancy",
    "description": "Enterprise multi-tenancy for Laravel: tenant identification by domain, subdomain, path or header, a fail-closed shared-database tier, schema and database-per-tenant tiers, tenant-aware infrastructure, lifecycle, plans, members and audit.",
    "keywords": [
        "laravel",
        "tenancy",
        "multi-tenant",
        "saas",
        "multitenancy"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/atannex/tenancy",
    "authors": [
        {
            "name": "Atangageih Leke Collins",
            "email": "atangageihlekecollins@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/atannex/tenancy/issues",
        "source": "https://github.com/atannex/tenancy"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/sanctum": "^4.0",
        "livewire/livewire": "^3.6|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0"
    },
    "suggest": {
        "ext-zip": "Tenant export and import (tenants:export, tenants:import).",
        "ext-redis": "RedisBootstrapper (per-tenant Redis prefixes need phpredis).",
        "laravel/octane": "Tenancy resets between Octane requests automatically.",
        "laravel/sanctum": "Guards the optional management API (auth:sanctum).",
        "laravel/scout": "ScoutBootstrapper prefixes search indexes per tenant.",
        "atannex/billing": "Moves tenants to the plan a payment paid for."
    },
    "autoload": {
        "psr-4": {
            "Atannex\\Tenancy\\": "src/",
            "Atannex\\Tenancy\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Atannex\\Tenancy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atannex\\Tenancy\\TenancyServiceProvider",
                "Atannex\\Tenancy\\TenancyModulesServiceProvider"
            ],
            "aliases": {
                "Tenancy": "Atannex\\Tenancy\\Facades\\Tenancy"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
